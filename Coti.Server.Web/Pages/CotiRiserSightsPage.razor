@page "/coti/riser"
@attribute [Authorize(Policy = "Administrator")]
@layout SPTarkov.Server.Web.Layout.BaseMudBlazorLayout

@inject ThermalRiserCompatibility Compatibility
@inject ThermalRiserDenyList DenyList

<CotiDenyListEditor Title="Thermal Riser Compatibility" Subject="thermal riser" DenyList="DenyList" RuleMatches="Matches"
                    Explanation="Switch a sight or mount off to keep it off the thermal riser." />

@code {
  private IReadOnlyDictionary<string, string?> Matches() =>
      Compatibility.RuleMatches.ToDictionary(id => id.ToString(), _ => (string?)null, StringComparer.OrdinalIgnoreCase);
}
