@page "/coti/model"
@attribute [Authorize(Policy = "Administrator")]
@layout SPTarkov.Server.Web.Layout.BaseMudBlazorLayout
@implements IAsyncDisposable

@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject CotiDeviceStore DeviceStore
@inject CotiDevicePublisher Publisher

<PageTitle>ECOTI mount editor</PageTitle>

<MudMainContent>
  @* No cap: the viewport is a 3D canvas, so width is usable space rather than line length. *@
  <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <CotiNav />

    <MudPaper Class="pa-4 mb-3" Elevation="3">
      <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
          <div>
            <MudText Typo="Typo.h5">Mount editor</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
              Drag to orbit, scroll to zoom, click a cube face to look down that axis.
            </MudText>
          </div>
          <MudSelect T="string" Value="@CurrentDevice?.Key" ValueChanged="SelectDevice" Dense="true"
                     Variant="Variant.Outlined" Style="min-width:250px" Label="Night vision device">
            @foreach (var d in deviceList)
            {
              <MudSelectItem T="string" Value="@d.Key">@d.Name</MudSelectItem>
            }
          </MudSelect>
          @if (CurrentDevice is { Hosts.Count: > 1 } current)
          {
            <MudSelect T="string" Value="@hostId" ValueChanged="SelectHost" Dense="true"
                       Variant="Variant.Outlined" Style="min-width:150px" Label="Variant">
              @foreach (var h in current.Hosts)
              {
                <MudSelectItem T="string" Value="@h.Id">@h.Label</MudSelectItem>
              }
            </MudSelect>
          }
          <MudTooltip Text="@sourceTooltip">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     Color="@(addonMod is null ? Color.Default : Color.Secondary)"
                     Icon="@(addonMod is null ? Icons.Material.Filled.Verified
                                              : Icons.Material.Filled.Extension)">@sourceLabel</MudChip>
          </MudTooltip>
        </MudStack>
        <MudStack Row="true" Spacing="2">
          @if (addonMod is not null)
          {
            @* The controller already sets Content-Disposition; naming it here as well costs
               nothing and does not depend on the header surviving a proxy. *@
            <MudButton StartIcon="@Icons.Material.Filled.Archive" Variant="Variant.Outlined"
                       Color="Color.Secondary" Href="@($"/coti/addon/{addonMod}")"
                       download="@CotiAddonPackager.FileNameFor(addonMod!)"
                       Disabled="@dirty">Export addon</MudButton>
          }
          <MudButton StartIcon="@Icons.Material.Filled.Undo" Variant="Variant.Outlined"
                     OnClick="Revert" Disabled="@(!dirty)">Revert</MudButton>
          <MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Filled"
                     Color="Color.Primary" OnClick="Save" Disabled="@(!dirty)">Save and push</MudButton>
        </MudStack>
      </MudStack>
    </MudPaper>

    @if (withoutMesh.Count > 0)
    {
      @* Was "converting mod bundles is not built yet". It is, so a device only lands here now
         when its bundle could not be read at all. *@
      <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
        No preview for @string.Join(", ", withoutMesh).
        COTI could not read a mesh out of @(withoutMesh.Count == 1 ? "its" : "their")
        bundle, and the server log says why.
      </MudAlert>
    }

    @if (message is not null)
    {
      <MudAlert Severity="@severity" Class="mb-3" ShowCloseIcon="true"
                CloseIconClicked="@(() => message = null)">@message</MudAlert>
    }

    @if (hostId is null)
    {
      <MudAlert Severity="Severity.Warning">
        No night vision device has a usable mesh, so there is nothing to edit.
      </MudAlert>
    }
    else
    {
      <MudPaper Class="pa-3" Elevation="2">
        <div @ref="mountRoot"></div>
      </MudPaper>
    }

  </MudContainer>
</MudMainContent>

@code {
  private ElementReference mountRoot;
  private IJSObjectReference? module;
  private DotNetObjectReference<CotiModelPage>? selfRef;

  /// <summary>One picker row. The mount is per device, so its hosts are variants of one entry.</summary>
  private sealed record DeviceEntry(string Key, string Name, List<(string Id, string Label)> Hosts);

  private readonly List<DeviceEntry> deviceList = new();
  private readonly List<string> withoutMesh = new();
  private CotiMaskBlock? maskOverride;
  private string? hostId;
  private bool dirty;
  private string? message;
  private Severity severity = Severity.Success;

  protected override void OnInitialized()
  {
    // Only hosts with a shipped mesh. A device without one is named rather than dropped.
    foreach (var device in DeviceStore.Current.ResolvedDevices)
    {
      foreach (var host in device.Hosts)
      {
        if (host?.Id is null)
        {
          continue;
        }

        var deviceName = device.DisplayName ?? device.Device ?? host.Id;

        if (!CotiHostMeshes.TryGetSlug(host.Id, out _))
        {
          // One entry per device, not per host: a device with three hosts was named three times.
          if (!withoutMesh.Contains(deviceName))
          {
            withoutMesh.Add(deviceName);
          }

          continue;
        }

        var key = device.Device ?? deviceName;
        var entry = deviceList.FirstOrDefault(d => d.Key == key);

        if (entry is null)
        {
          entry = new DeviceEntry(key, deviceName, new List<(string, string)>());
          deviceList.Add(entry);
        }

        entry.Hosts.Add((host.Id, LabelFor(entry, host)));
      }
    }

    hostId = deviceList.FirstOrDefault()?.Hosts.FirstOrDefault().Id;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender || hostId is null)
    {
      return;
    }

    // A viewer that fails to start leaves the host list and save controls up, and reports why.
    try
    {
      selfRef = DotNetObjectReference.Create(this);
      module = await JS.InvokeAsync<IJSObjectReference>(
        "import", $"/coti-assets/js/interop.js?v={CotiAssetStamp.Current}");
      await module.InvokeVoidAsync(
        "start", mountRoot, BuildHostTable(), hostId, selfRef, CotiAssetStamp.Current);
    }
    catch (Exception ex)
    {
      message = $"The 3D viewer could not start: {ex.Message}";
      severity = Severity.Error;
      await InvokeAsync(StateHasChanged);
    }
  }

  /// <summary>
  /// <summary>The viewer's overlay buttons land here; the pick is saved with the mount.</summary>
  [JSInvokable]
  public Task OnMask(string name)
  {
    var preset = CotiMaskPresets.ByName(name);

    if (preset is null)
    {
      return Task.CompletedTask;
    }

    maskOverride = preset;
    dirty = true;
    return InvokeAsync(StateHasChanged);
  }

  /// <summary>The device whose variant is on screen.</summary>
  private DeviceEntry? CurrentDevice =>
    deviceList.FirstOrDefault(d => d.Hosts.Any(h => h.Id == hostId));

  /// <summary>A variant's own name. Devices that never labelled their hosts get a position.</summary>
  private static string LabelFor(DeviceEntry entry, CotiHostRef host)
  {
    return string.IsNullOrWhiteSpace(host.Label) ? $"Variant {entry.Hosts.Count + 1}" : host.Label;
  }

  /// <summary>Picking a device shows its first variant; they share one mount either way.</summary>
  private Task SelectDevice(string key)
  {
    var entry = deviceList.FirstOrDefault(d => d.Key == key);
    return entry is null ? Task.CompletedTask : SelectHost(entry.Hosts[0].Id);
  }

  /// <summary>
  /// Everything the viewer needs to pose a device: the mesh slug, the mount and mask blocks, and
  /// the world transform of every bone a mount could anchor to.
  /// </summary>
  private string BuildHostTable()
  {
    var table = new Dictionary<string, object>();

    foreach (var device in DeviceStore.Current.ResolvedDevices)
    {
      foreach (var host in device.Hosts)
      {
        if (host?.Id is null || !CotiHostMeshes.TryGetSlug(host.Id, out var slug))
        {
          continue;
        }

        var (pivot, hasPivotMesh) = CotiHostMeshes.PivotFor(host.Id);
        var hasStaticMesh = CotiHostMeshes.HasStaticMesh(host.Id);

        table[host.Id] = new
        {
          slug,
          pivot,
          hasPivotMesh,
          hasStaticMesh,
          name = device.DisplayName ?? device.Device,
          maskPreset = CotiMaskPresets.NameFor(device.Mask),
          maskBlurb = CotiMaskPresets.NameFor(device.Mask) == CotiMaskPresets.Custom
            ? CotiMaskPresets.CustomGuidance
            : CotiMaskPresets.Guidance,
          device = device.Device,
          // The DTO carries the camelCase names the device files and the viewer both use.
          mount = CotiMountBlockDto.FromShared(device.Mount),
          mask = CotiMaskBlockDto.FromShared(device.Mask),
          bones = CotiHostMeshes.BonesFor(host.Id),
        };
      }
    }

    return JsonSerializer.Serialize(table);
  }

  /// <summary>
  /// The mod the current host comes from, or null for a vanilla one.
  /// </summary>
  private string? addonMod =>
    DeviceStore.Current.ResolvedDevices
      .FirstOrDefault(d => d.Hosts.Any(h => h?.Id == hostId))?.Requires is { Length: > 0 } requires
        ? requires
        : null;

  /// <summary>Where the selected host comes from. The tooltip carries the raw plugin id.</summary>
  private string sourceLabel => addonMod is null ? "Vanilla" : CotiAddonPackager.SlugFor(addonMod);

  private string sourceTooltip => addonMod is null
    ? "Ships with Escape from Tarkov. Its pose ships inside COTI."
    : $"Added by {addonMod}. Its pose can be exported as an addon.";

  private async Task SelectHost(string value)
  {
    hostId = value;
    maskOverride = null;
    dirty = false;
    if (module is not null)
    {
      await module.InvokeVoidAsync("setHost", value);
    }
  }

  [JSInvokable]
  public Task OnDirty(bool value)
  {
    dirty = value;
    return InvokeAsync(StateHasChanged);
  }

  private async Task Revert()
  {
    if (module is not null)
    {
      await module.InvokeVoidAsync("revert");
    }

    maskOverride = null;
    dirty = false;
  }

  private async Task Save()
  {
    if (module is null || hostId is null)
    {
      return;
    }

    var json = await module.InvokeAsync<string>("getMount");
    var edited = JsonSerializer.Deserialize<CotiMountBlockDto>(json, JsonOpts)?.ToShared();

    if (edited is null)
    {
      message = "Could not read the edited mount.";
      severity = Severity.Error;
      return;
    }

    var device = DeviceStore.Current.ResolvedDevices
      .FirstOrDefault(d => d.Hosts.Any(h => h?.Id == hostId));

    if (device is null)
    {
      message = "That device is no longer in the device store.";
      severity = Severity.Error;
      return;
    }

    // Rounded through the same helper the in-game tuner uses.
    device.Mount = CotiMountRounding.Round(edited);

    if (maskOverride is not null)
    {
      device.Mask = maskOverride;
    }

    // Saving makes this device a seed donor for its family, so a wrong mask here does not stay
    // local - it becomes the starting point for every device discovered after it.
    device.Tuned = true;

    var result = Publisher.Publish(device, "web mount editor");

    if (result.Ok != true)
    {
      message = $"Rejected: {result.Error}";
      severity = Severity.Error;
      return;
    }

    await module.InvokeVoidAsync("markSaved");
    maskOverride = null;
    dirty = false;
    message = "Saved and pushed. A running client re-poses immediately; no restart.";
    severity = Severity.Success;
  }

  private static readonly JsonSerializerOptions JsonOpts = new() { PropertyNameCaseInsensitive = true };

  public async ValueTask DisposeAsync()
  {
    if (module is not null)
    {
      try
      {
        await module.InvokeVoidAsync("stop");
        await module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
        // The circuit is already gone.
      }
    }

    selfRef?.Dispose();
  }
}
