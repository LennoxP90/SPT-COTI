<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Coti.Server.Web</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <SptRefDir>F:\Games\SPT-4.1\SPT-4.1-Clean\SPT_Runtime</SptRefDir>
    <SptPackageVersion>4.1.3</SptPackageVersion>
    <SptRefsPresent>false</SptRefsPresent>
    <SptRefsPresent Condition="Exists('$(SptRefDir)\SPTarkov.Server.Core.dll')">true</SptRefsPresent>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coti.Server\Coti.Server.csproj" Private="false" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(SptRefsPresent)' != 'true'">
    <PackageReference Include="SPTushonka.Server.Core" Version="$(SptPackageVersion)" />
    <PackageReference Include="SPTushonka.Server.Web" Version="$(SptPackageVersion)" />
    <PackageReference Include="SPTushonka.DI" Version="$(SptPackageVersion)" />
    <PackageReference Include="SPTushonka.Common" Version="$(SptPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(SptRefsPresent)' == 'true'">
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptRefDir)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Web"><HintPath>$(SptRefDir)\SPTarkov.Server.Web.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptRefDir)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptRefDir)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MudBlazor"><HintPath>$(SptRefDir)\MudBlazor.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateSptCoreFloor" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SptRefsPresent)' == 'true'">
    <GetAssemblyIdentity AssemblyFiles="$(SptRefDir)\SPTarkov.Server.Core.dll">
      <Output TaskParameter="Assemblies" ItemName="SptCoreLocalAssembly" />
    </GetAssemblyIdentity>

    <PropertyGroup>
      <SptCoreLocalVersionRaw>@(SptCoreLocalAssembly->'%(Version)')</SptCoreLocalVersionRaw>
      <SptCoreLocalVersion>$(SptCoreLocalVersionRaw.Split('.')[0]).$(SptCoreLocalVersionRaw.Split('.')[1]).$(SptCoreLocalVersionRaw.Split('.')[2])</SptCoreLocalVersion>
    </PropertyGroup>

    <Error
        Condition="$([MSBuild]::VersionGreaterThan('$(SptCoreLocalVersion)', '$(SptPackageVersion)'))"
        Text="Coti.Server.Web ($(TargetFramework)): the local install at $(SptRefDir) carries SPTarkov.Server.Core $(SptCoreLocalVersion), above the declared floor SptPackageVersion=$(SptPackageVersion). Building against it as-is would silently raise the mod's real minimum server version, since ModValidator.ValidateCoreAssemblyReference throws out of the mod loader on any server below the compile-time Core. Either raise SptPackageVersion (and ModMetadata.cs's SptVersion) to $(SptCoreLocalVersion) as a deliberate decision, or point SptRefDir at an install at or below $(SptPackageVersion)." />
  </Target>

  <PropertyGroup>
    <CotiDist>$(MSBuildProjectDirectory)\..\dist\$(Configuration)\spt-4.1\SPT_Runtime\user\mods\LennoxP90-COTI</CotiDist>
  </PropertyGroup>

  <ItemGroup>
    <CotiWebAsset Include="wwwroot\**\*" />
  </ItemGroup>

  <Target Name="StageCotiServerWeb" AfterTargets="Build">
    <ItemGroup>
      <CotiWebOutput Include="$(OutDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(CotiWebOutput)" DestinationFolder="$(CotiDist)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CotiWebAsset)"
          DestinationFolder="$(OutDir)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CotiWebAsset)"
          DestinationFolder="$(CotiDist)\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\meshes\index.json')"
           Text="No mesh index. The mount editor needs Coti.Server.Web/wwwroot/meshes; regenerate with scripts/export-host-meshes.py." />
  </Target>

</Project>
