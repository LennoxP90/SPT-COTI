<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Coti.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <SptRef40Dir>F:\Games\SPT-4.0\Clean\SPT</SptRef40Dir>
    <SptRef41Dir>F:\Games\SPT-4.1\SPT-4.1-Clean\SPT_Runtime</SptRef41Dir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <DefineConstants>$(DefineConstants);SPT40</DefineConstants>
    <SptRefDir>$(SptRef40Dir)</SptRefDir>
    <SptPackageVersion>4.0.13</SptPackageVersion>
    <SptPackageId>SPTarkov.Server.Core</SptPackageId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);SPT41</DefineConstants>
    <SptRefDir>$(SptRef41Dir)</SptRefDir>
    <SptPackageVersion>4.1.3</SptPackageVersion>
    <SptPackageId>SPTushonka.Server.Core</SptPackageId>
  </PropertyGroup>

  <PropertyGroup>
    <SptRefsPresent>false</SptRefsPresent>
    <SptRefsPresent Condition="Exists('$(SptRefDir)\SPTarkov.Server.Core.dll')">true</SptRefsPresent>
  </PropertyGroup>

  <ItemGroup Condition="'$(SptRefsPresent)' != 'true'">
    <PackageReference Include="$(SptPackageId)" Version="$(SptPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(SptRefsPresent)' == 'true'">
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptRefDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptRefDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptRefDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Reflection">
      <HintPath>$(SptRefDir)\SPTarkov.Reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptRefDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ReportSptRefs" BeforeTargets="ResolveAssemblyReferences">
    <Message Importance="high" Condition="'$(SptRefsPresent)' == 'true'"
             Text="Coti.Server ($(TargetFramework)): referencing the install at $(SptRefDir)" />
    <Message Importance="high" Condition="'$(SptRefsPresent)' != 'true'"
             Text="Coti.Server ($(TargetFramework)): no install at $(SptRefDir), using $(SptPackageId) $(SptPackageVersion) from NuGet" />
  </Target>

  <Target Name="ValidateSptCoreFloor" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SptRefsPresent)' == 'true'">
    <GetAssemblyIdentity AssemblyFiles="$(SptRefDir)\SPTarkov.Server.Core.dll">
      <Output TaskParameter="Assemblies" ItemName="SptCoreLocalAssembly" />
    </GetAssemblyIdentity>

    <PropertyGroup>
      <SptCoreLocalVersionRaw>@(SptCoreLocalAssembly->'%(Version)')</SptCoreLocalVersionRaw>
      <SptCoreLocalVersion>$(SptCoreLocalVersionRaw.Split('.')[0]).$(SptCoreLocalVersionRaw.Split('.')[1]).$(SptCoreLocalVersionRaw.Split('.')[2])</SptCoreLocalVersion>
    </PropertyGroup>

    <Error
        Condition="$([MSBuild]::VersionGreaterThan('$(SptCoreLocalVersion)', '$(SptPackageVersion)'))"
        Text="Coti.Server ($(TargetFramework)): the local install at $(SptRefDir) carries SPTarkov.Server.Core $(SptCoreLocalVersion), above the declared floor SptPackageVersion=$(SptPackageVersion). Building against it as-is would silently raise the mod's real minimum server version, since ModValidator.ValidateCoreAssemblyReference throws out of the mod loader on any server below the compile-time Core. Either raise SptPackageVersion (and ModMetadata.cs's SptVersion) to $(SptCoreLocalVersion) as a deliberate decision, or point SptRefDir at an install at or below $(SptPackageVersion)." />
  </Target>

  <ItemGroup>
    <None Update="bundles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Update="config\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <CotiDist>$(MSBuildProjectDirectory)\..\dist\$(Configuration)\spt-4.0\SPT\user\mods\LennoxP90-COTI</CotiDist>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <CotiDist>$(MSBuildProjectDirectory)\..\dist\$(Configuration)\spt-4.1\SPT_Runtime\user\mods\LennoxP90-COTI</CotiDist>
  </PropertyGroup>

  <Target Name="StageCotiServer" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <CotiModelBundle Include="$(MSBuildProjectDirectory)\..\bundles\coti\**\*" Exclude="**\*.manifest" />
    </ItemGroup>

    <Copy SourceFiles="@(CotiModelBundle)"
          DestinationFolder="$(OutDir)bundles\coti\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(CotiModelBundle)' != ''" />

    <Warning Text="No COTI model bundle in bundles/coti - the item will render as the donor rail mount. Rebuild it with Unity (COTI > Build Everything)."
             Condition="'@(CotiModelBundle)' == ''" />

    <Copy SourceFiles="$(TargetPath);$(OutDir)$(AssemblyName).deps.json;bundles.json"
          DestinationFolder="$(CotiDist)"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(CotiModelBundle)"
          DestinationFolder="$(CotiDist)\bundles\coti\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(CotiModelBundle)' != ''" />

    <Copy SourceFiles="config\config.json"
          DestinationFolder="$(CotiDist)\config"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <CotiHostFile Include="$(MSBuildProjectDirectory)\..\hosts\*.json" />
    </ItemGroup>

    <ItemGroup>
      <CotiStaleHostFile Include="$(CotiDist)\nvghostcompat\*.json" />
    </ItemGroup>

    <Delete Files="@(CotiStaleHostFile)" Condition="'@(CotiStaleHostFile)' != ''" />

    <Copy SourceFiles="@(CotiHostFile)"
          DestinationFolder="$(CotiDist)\nvghostcompat"
          Condition="'@(CotiHostFile)' != ''" />
  </Target>

</Project>
