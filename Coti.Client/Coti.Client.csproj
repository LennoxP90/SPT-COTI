<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Coti.Client</AssemblyName>
    <Description>ECOTI client plugin - F12 config, thermal circles, headless no-op</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);COTI_DEV</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <SptTarget Condition="'$(SptTarget)' == ''">4.1</SptTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SptTarget)' == '4.0'">
    <DefineConstants>$(DefineConstants);SPT40</DefineConstants>
    <SptRoot Condition="'$(SptRoot)' == ''">F:\Games\SPT-4.0\Clean</SptRoot>
    <BaseOutputPath>bin\spt-4.0\</BaseOutputPath>
    <CotiDistRoot>spt-4.0</CotiDistRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SptTarget)' == '4.1'">
    <DefineConstants>$(DefineConstants);SPT41</DefineConstants>
    <BaseOutputPath>bin\spt-4.1\</BaseOutputPath>
    <CotiDistRoot>spt-4.1</CotiDistRoot>
  </PropertyGroup>

  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == ''">F:\Games\SPT-4.1\SPT-4.1-client</SptRoot>
    <SptManaged>$(SptRoot)\EscapeFromTarkov_Data\Managed</SptManaged>
    <SptPlugins>$(SptRoot)\BepInEx\plugins</SptPlugins>
    <SptSptPlugins>$(SptRoot)\BepInEx\plugins\spt</SptSptPlugins>
  </PropertyGroup>

  <Target Name="CheckEftRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(SptTarget)' != '4.0' AND '$(SptTarget)' != '4.1'"
           Text="SptTarget must be 4.0 or 4.1, but was '$(SptTarget)'. Build with /p:SptTarget=4.0 or /p:SptTarget=4.1." />

    <Error Condition="!Exists('$(SptManaged)\Assembly-CSharp.dll')"
           Text="EFT assemblies not found at $(SptManaged) for SptTarget=$(SptTarget). Set SptRoot to that install." />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Comfort">
      <HintPath>$(SptManaged)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptManaged)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SptManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(SptManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(SptManaged)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SptManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SptManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SptManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SptManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(SptManaged)\UnityEngine.TerrainModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(SptManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(SptManaged)\Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json, Version=13.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <SpecificVersion>False</SpecificVersion>
      <HintPath>$(SptManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptSptPlugins)\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptSptPlugins)\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Coti.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The in-game editor (pose tuner, mask panel, inspect button) is in the 4.0 build only; the web viewer at
       /coti/model is the editor everywhere else. Removed here rather than #if'd inside the files, because Coti.Tests
       links several of them and defines no SPT symbol. -->
  <ItemGroup Condition="'$(SptTarget)' != '4.0'">
    <Compile Remove="CotiTunerPanel.cs" />
    <Compile Remove="CotiMaskPanel.cs" />
    <Compile Remove="CotiMaskNudge.cs" />
    <Compile Remove="CotiDpad.cs" />
    <Compile Remove="CotiAnchorAdvisor.cs" />
    <Compile Remove="CotiPoseTuner.cs" />
    <Compile Remove="CotiTunerPreview.cs" />
    <Compile Remove="CotiInspectButton.cs" />
    <Compile Remove="CotiUiBlocker.cs" />
    <Compile Remove="CotiGuiFill.cs" />
    <Compile Remove="CotiOrbitMath.cs" />
    <Compile Remove="CotiLayerMask.cs" />
    <Compile Remove="CotiPublishReport.cs" />
    <Compile Remove="Dev\CotiInspectButtonProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\slot_mod_coti.png" />

    <EmbeddedResource Include="..\hosts\*.json" Link="Hosts\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <CotiShaderBundlePath>$(MSBuildProjectDirectory)\..\bundles\coti_shaders</CotiShaderBundlePath>
    <CotiDist>$(MSBuildProjectDirectory)\..\dist\$(Configuration)\$(CotiDistRoot)\BepInEx\plugins\LennoxP90-COTI</CotiDist>
  </PropertyGroup>

  <Target Name="StageCotiClient" AfterTargets="Build">
    <Warning Text="No coti_shaders in bundles/ - the overlay will not draw. Rebuild it with Unity (COTI &gt; Build Everything)."
             Condition="!Exists('$(CotiShaderBundlePath)')" />

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(CotiDist)"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="$(CotiShaderBundlePath)"
          DestinationFolder="$(CotiDist)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(CotiShaderBundlePath)')" />

    <ItemGroup>
      <CotiSounds Include="$(MSBuildProjectDirectory)\..\sounds\*.wav" />
      <CotiTextures Include="$(MSBuildProjectDirectory)\..\textures\*.png" />
    </ItemGroup>

    <Copy SourceFiles="@(CotiSounds)"
          DestinationFolder="$(CotiDist)\sounds"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(CotiTextures)"
          DestinationFolder="$(CotiDist)\textures"
          SkipUnchangedFiles="true" />

    <!-- The lamps the thermal image heats, read beside the DLL at every raid start; without it no lamp shows heat. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\lamps.json"
          DestinationFolder="$(CotiDist)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
