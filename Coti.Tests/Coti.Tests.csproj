    <Compile Include="..\Coti.Client\CotiConfig.cs" Link="Client\CotiConfig.cs" />
    <Compile Include="..\Coti.Client\CotiImageConfig.cs" Link="Client\CotiImageConfig.cs" />
    <Compile Include="..\Coti.Client\MaskGeometry.cs" Link="Client\MaskGeometry.cs" />
    <Compile Include="..\Coti.Server\CotiDeviceDto.cs" Link="Server\CotiDeviceDto.cs" />
    <Compile Include="..\Coti.Client\CotiDeviceDto.cs" Link="Client\CotiDeviceDto.cs" />
    <Compile Include="..\Coti.Client\CotiInspectGate.cs" Link="Client\CotiInspectGate.cs" />
    <Compile Include="..\Coti.Client\CotiAnchorAdvisor.cs" Link="Client\CotiAnchorAdvisor.cs" />
    <Compile Include="..\Coti.Client\CotiOrbitMath.cs" Link="Client\CotiOrbitMath.cs" />
    <Compile Include="..\Coti.Client\CotiLayerMask.cs" Link="Client\CotiLayerMask.cs" />
