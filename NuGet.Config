<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    An explicit mapping is required here. If the machine-level NuGet.Config enables
    packageSourceMapping without listing the BepInEx feed, every BepInEx.* package is
    excluded from restore with NU1101 even though the source is declared above.
    Declaring the mapping locally keeps the fix inside this repo.
  -->
  <packageSourceMapping>
    <packageSource key="BepInEx">
      <package pattern="BepInEx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
