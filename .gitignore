bin/
obj/
*.user
.vs/
.superpowers/

# Purchased third-party model source. Licence forbids redistributing raw files; only the
# compiled AssetBundle may ship. Keep these local.
unity/blender/purchased/

# VS generates this for the Web SDK the server mod builds against; it is not used.
**/Properties/launchSettings.json
dist/

# Coti.Server's StageCotiServer build target copies the model bundle into the build output
# (Coti.Server/bundles/coti/...) so it can be staged to dist/. The real bundles live at the
# repo root under bundles/ - this is build residue, not a source location.
Coti.Server/bundles/

# Downloaded host-mod archives kept locally for pose tuning (C11 - True North is 1.7 GB).
# Never redistributed and never committed; the release process 7z's from dist/, which is ignored above.
*.7z
.playwright-mcp/

# Meshes converted from other mods bundles. Install-specific and not ours to ship.
Coti.Server.Web/wwwroot/meshes-local/
